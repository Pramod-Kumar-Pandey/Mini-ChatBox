<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>
<body>
    <div class="row offset-1.5">
        <div class="row-col-4">
        <h2>All Chats</h2>
        <form method="get" action="/chats/new">
            <button class="btn-dark">New Chat</button>
        </form>
        <br>
        <% for(let chat of chats){%>
            <div class="chat">
                <p>From : <i><%=chat.from%></i></p>
                <div class="msg">
                    <p><%=chat.msg%></p>
                    <div class="btns">
                        <form method="get" action="/chats/<%=chat._id%>/edit">
                            <button class="btn-dark">Edit</button>
                        </form>
                        <form method="post" action="/chats/<%=chat._id%>?_method=DELETE">
                            <button class="btn-dark">Delete</button>
                        </form>

                        <!-- <form method="get" action="/chats/<%=chat._id%>">
                            <button class="btn-dark">Show</button> 
                        </form> -->
                    </div>
                    

                </div>
                <p>Received by : <i><%=chat.to%></i></p>
                <hr>
                <p><%=chat.created_at.toString().split(" ")[4]%></p>
                <p><%=chat.created_at.toString().split(" ").slice(0,4).join(" ")%></p>
            </div>
            
        <%}%>
        </div>
    </div>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>